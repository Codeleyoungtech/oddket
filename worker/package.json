{
  "name": "@oddket/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test:local": "node scripts/bundle.mjs && node test/e2e.mjs",
    "serve:local": "node scripts/bundle.mjs && node scripts/serve.mjs",
    "migrate:local": "wrangler d1 migrations apply oddket --local",
    "migrate:remote": "wrangler d1 migrations apply oddket --remote"
  },
  "dependencies": {
    "@oddket/core": "workspace:*",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "esbuild": "0.17.19",
    "typescript": "^5.6.3",
    "wrangler": "^3.99.0"
  }
}
